# Settings for the Expo app AND the Python backend in backend/, in one file.
# Copy to .env (git-ignored) and fill in. Restart `npx expo start` and uvicorn after editing.
# Only EXPO_PUBLIC_* variables are built into the app; everything else stays on the backend.

# --- Shared -------------------------------------------------------------------
# Clerk publishable key (Clerk Dashboard -> API keys). Not a secret: it only names the instance.
# The app signs in with it; the backend verifies the app's session tokens against it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Expo app -----------------------------------------------------------------
# The FastAPI backend. Comment out to run the app on mock data.
# On a phone, localhost is replaced with this computer's address automatically.
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- Backend (secrets: never give these an EXPO_PUBLIC_ prefix) ---------------
ANTHROPIC_API_KEY=
# Tracing; optional.
BRAINTRUST_API_KEY=
# Optional static bearer token for curl and scripts (the app sends its Clerk session token).
PERSONAL_BANKER_API_TOKEN=
# Optional: the Clerk user id whose data that token sees (otherwise a user of its own, "api-token").
# PERSONAL_BANKER_API_TOKEN_USER=
# The Clerk user id Streamlit and the command-line tools work as; optional while only one user has data.
# PERSONAL_BANKER_LOCAL_USER=
# Optional: a budget workbook to categorize with (its categories, past entries and vendor rules).
# Without one, statements are sorted into the app's own categories.
# PERSONAL_BANKER_WORKBOOK=data/BudgetTracking_Setareh.xlsx
# Statement extraction: claude (default; fast, uses ANTHROPIC_API_KEY) or paddleocr-vl
# (local GPU, slow; needs `uv sync --extra paddle`).
PERSONAL_BANKER_EXTRACTION_ENGINE=claude
# Optional: comma-separated Clerk user ids allowed to use the API (otherwise anyone who can sign in).
# CLERK_ALLOWED_USER_IDS=
# Optional overrides.
# BRAINTRUST_PROJECT=Personal Banker
# ANTHROPIC_WORKSPACE_ID=
# PERSONAL_BANKER_LIBRARY=library
